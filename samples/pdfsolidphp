#!/usr/bin/env bash
# pdfsolidphp — runs PHP with the Conversion native libraries preloaded
# via LD_PRELOAD on Linux. Required because the SDK ships its own allocator
# (PartitionAlloc) which conflicts with PHP's already-initialised libc heap if
# the library is loaded lazily via FFI::cdef(). Preloading at process start
# makes all of the SDK's static constructors run before PHP allocates anything,
# matching the load order used by the Python wheel and the standalone C demos.
#
# Usage:
#   samples/pdfsolidphp samples/version.php
#   samples/pdfsolidphp samples/direct_convert_demo.php
#
# Environment:
#   CONVERSION_LIB_DIR  override the directory holding the native libraries.
#   CONVERSION_PHP_NATIVE_SDK_NAME  native SDK basename without lib/.so
#                                   (default: pdfsolidconversionsdk).
#
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PKG_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
OS_LOWER="$(uname -s | tr '[:upper:]' '[:lower:]')"

case "${OS_LOWER}" in
  linux*)
    LIB_DIR="${CONVERSION_LIB_DIR:-${PKG_ROOT}/lib/linux}"
    SDK_NAME="${CONVERSION_PHP_NATIVE_SDK_NAME:-pdfsolidconversionsdk}"
    SDK_SO="lib${SDK_NAME}.so"
    if [ ! -d "${LIB_DIR}" ]; then
      echo "pdfsolidphp: library directory not found: ${LIB_DIR}" >&2
      exit 1
    fi
    if [ ! -f "${LIB_DIR}/${SDK_SO}" ]; then
      echo "pdfsolidphp: native SDK library not found: ${LIB_DIR}/${SDK_SO}" >&2
      exit 1
    fi
    PRELOAD="${LIB_DIR}/libonnxruntime.so.1:${LIB_DIR}/libopencv_world.so.410:${LIB_DIR}/libDocumentAI.so.4.3.0:${LIB_DIR}/${SDK_SO}"
    export LD_PRELOAD="${PRELOAD}${LD_PRELOAD:+:${LD_PRELOAD}}"
    export LD_LIBRARY_PATH="${LIB_DIR}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
    export CONVERSION_LIB_DIR="${LIB_DIR}"
    exec php "$@"
    ;;
  *)
    echo "pdfsolidphp: unsupported OS for this Linux package: ${OS_LOWER}" >&2
    exit 1
    ;;
esac
